{
  "list_accounts": {
    "description": "List locally connected addresses and their access modes. For first connection run ma-ru connect.",
    "fields": []
  },
  "lazy_digest": {
    "description": "Read the local backlog digest. Continue with its run ID and next_offset for more items.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "run_id",
        "type": "string"
      },
      {
        "name": "offset",
        "type": "integer",
        "default": 0,
        "minimum": 0
      },
      {
        "name": "limit",
        "type": "integer",
        "default": 20,
        "minimum": 1,
        "maximum": 100
      }
    ]
  },
  "lazy_run": {
    "description": "Run owner-configured backlog cleanup with explicit message and token budgets. May move mail to Trash or review.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "max_messages",
        "type": "integer",
        "required": true,
        "minimum": 1,
        "maximum": 1000
      },
      {
        "name": "token_budget",
        "type": "integer",
        "required": true,
        "minimum": 512,
        "maximum": 1000000
      }
    ]
  },
  "list_folders": {
    "description": "Show folder rules, effective modes, roles and optional permitted counts for one mailbox.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "counts",
        "type": "boolean",
        "default": false
      }
    ]
  },
  "set_mailbox_name": {
    "description": "Set the local display name. The full email address remains visible.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "name",
        "type": "string",
        "required": true
      }
    ]
  },
  "set_folder_rule": {
    "description": "Set a mailbox-local folder rule. Restoring access to a blocked branch requires interactive owner consent.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "folder",
        "type": "string",
        "required": true
      },
      {
        "name": "mode",
        "type": "string",
        "options": [
          "priority",
          "normal",
          "skip",
          "blocked",
          "inherit"
        ],
        "required": true
      }
    ]
  },
  "search_messages": {
    "description": "Search one explicit permitted folder or all active folders in priority order. Continue with next_before and identical filters.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "filters",
        "type": "object",
        "required": true
      },
      {
        "name": "folder",
        "type": "string"
      },
      {
        "name": "limit",
        "type": "integer",
        "default": 25,
        "minimum": 1,
        "maximum": 100
      },
      {
        "name": "before",
        "type": "object"
      }
    ]
  },
  "read_message": {
    "description": "Read a message without marking it seen; list attachments and page through the body.",
    "fields": [
      {
        "name": "ref",
        "type": "object",
        "required": true
      },
      {
        "name": "offset",
        "type": "integer",
        "default": 0,
        "minimum": 0
      },
      {
        "name": "count",
        "type": "integer",
        "default": 24000,
        "minimum": 1,
        "maximum": 60000
      }
    ]
  },
  "read_messages": {
    "description": "Read a batch from one account with a body preview for each message.",
    "fields": [
      {
        "name": "refs",
        "type": "array",
        "required": true
      }
    ]
  },
  "read_thread": {
    "description": "Find related messages by RFC Message-ID, In-Reply-To and References. Repeat with identical arguments while index_complete is false. Read selected bodies with read_messages.",
    "fields": [
      {
        "name": "ref",
        "type": "object",
        "required": true
      },
      {
        "name": "folder",
        "type": "string"
      },
      {
        "name": "limit",
        "type": "integer",
        "default": 40,
        "minimum": 1,
        "maximum": 100
      }
    ]
  },
  "read_attachment": {
    "description": "Read a MIME attachment in base64 chunks. Offset and count are bytes before encoding.",
    "fields": [
      {
        "name": "ref",
        "type": "object",
        "required": true
      },
      {
        "name": "part",
        "type": "integer",
        "required": true,
        "minimum": 1
      },
      {
        "name": "offset",
        "type": "integer",
        "default": 0,
        "minimum": 0
      },
      {
        "name": "count",
        "type": "integer",
        "default": 65536,
        "minimum": 1,
        "maximum": 524288
      }
    ]
  },
  "route_attachments": {
    "description": "Match any owner-selected phrase in subject/body. An explicit [] matches all mail.",
    "fields": [
      {
        "name": "ref",
        "type": "object",
        "required": true
      },
      {
        "name": "disk_owner_uid",
        "type": "string",
        "required": true
      },
      {
        "name": "disk_folder",
        "type": "string",
        "required": true
      },
      {
        "name": "phrases",
        "type": "array",
        "required": true
      },
      {
        "name": "preview",
        "type": "boolean",
        "default": true
      },
      {
        "name": "deadline",
        "type": "object"
      }
    ]
  },
  "list_labels": {
    "description": "List server keywords and registered labels. Message local_labels identify plugin-only tags.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "folder",
        "type": "string",
        "default": "INBOX"
      }
    ]
  },
  "count_messages": {
    "description": "Count total and unread matches. A Message-ID filter reads identifier headers only.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "filters",
        "type": "object",
        "required": true
      },
      {
        "name": "folder",
        "type": "string",
        "default": "INBOX"
      }
    ]
  },
  "create_label": {
    "description": "Register an IMAP label name for this account. Applying it uses a server keyword when supported, or a personal plugin tag.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "name",
        "type": "string",
        "required": true
      }
    ]
  },
  "modify_messages": {
    "description": "Apply or remove labels, mark read/unread, star/unstar up to 100 selected messages in one folder.",
    "fields": [
      {
        "name": "refs",
        "type": "array",
        "required": true
      },
      {
        "name": "changes",
        "type": "object",
        "required": true
      }
    ]
  },
  "create_folder": {
    "description": "Create a mailbox folder.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "folder",
        "type": "string",
        "required": true
      }
    ]
  },
  "move_messages": {
    "description": "Move a selected batch in one folder, archive, or move to Trash. Choose either an exact folder or a system role. No mailbox-wide expunge.",
    "fields": [
      {
        "name": "refs",
        "type": "array",
        "required": true
      },
      {
        "name": "folder",
        "type": "string"
      },
      {
        "name": "role",
        "type": "string",
        "options": [
          "archive",
          "trash",
          "spam",
          "drafts",
          "sent"
        ]
      }
    ]
  },
  "list_drafts": {
    "description": "List saved drafts, newest UIDs first.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "limit",
        "type": "integer",
        "default": 25,
        "minimum": 1,
        "maximum": 100
      },
      {
        "name": "before",
        "type": "object"
      }
    ]
  },
  "prepare_reply": {
    "description": "Create a reply draft, using the receiving mailbox unless the user explicitly selects another sender.",
    "fields": [
      {
        "name": "ref",
        "type": "object",
        "required": true
      },
      {
        "name": "text",
        "type": "string",
        "required": true
      },
      {
        "name": "from_account",
        "type": "string"
      }
    ]
  },
  "create_draft": {
    "description": "Save a server-side draft, reply or forward, with optional MIME attachments. Does not send.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "letter",
        "type": "object",
        "required": true
      }
    ]
  },
  "update_draft": {
    "description": "Replace a draft with the supplied full letter including attachments. Save first, then move the old draft to Trash. Reusing the source ref and identical letter does not append another revision. On check_original inspect both folders.",
    "fields": [
      {
        "name": "ref",
        "type": "object",
        "required": true
      },
      {
        "name": "letter",
        "type": "object",
        "required": true
      }
    ]
  },
  "send_email": {
    "description": "Send the explicitly requested letter by SMTP. Reuse the identical request_id when retrying; accepted addresses mean SMTP acceptance.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "request_id",
        "type": "string",
        "required": true
      },
      {
        "name": "letter",
        "type": "object",
        "required": true
      }
    ]
  },
  "send_draft": {
    "description": "Send a reviewed draft once for this draft UID. The draft stays available for inspection or a subsequent move to Trash.",
    "fields": [
      {
        "name": "ref",
        "type": "object",
        "required": true
      }
    ]
  },
  "poll_new": {
    "description": "Read the next unacknowledged batch for a named schedule. First call starts at current UIDNEXT unless include_existing. Same batch may be redelivered until acknowledged.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "feed",
        "type": "string",
        "required": true
      },
      {
        "name": "folder",
        "type": "string",
        "default": "INBOX"
      },
      {
        "name": "limit",
        "type": "integer",
        "default": 25,
        "minimum": 1,
        "maximum": 100
      },
      {
        "name": "include_existing",
        "type": "boolean",
        "default": false
      }
    ]
  },
  "mailbox_overview": {
    "description": "Group messages by receiving account and folder, priority folders first. Omit scopes for all accounts.",
    "fields": [
      {
        "name": "scopes",
        "type": "array"
      },
      {
        "name": "filters",
        "type": "object"
      },
      {
        "name": "limit_per_folder",
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 100
      }
    ]
  },
  "poll_mailboxes": {
    "description": "Poll each selected mailbox's active folders. Acknowledge each successful folder receipt separately.",
    "fields": [
      {
        "name": "feed",
        "type": "string",
        "required": true
      },
      {
        "name": "scopes",
        "type": "array",
        "required": true
      },
      {
        "name": "limit_per_folder",
        "type": "integer",
        "default": 10,
        "minimum": 1,
        "maximum": 100
      },
      {
        "name": "include_existing",
        "type": "boolean",
        "default": false
      }
    ]
  },
  "acknowledge_batch": {
    "description": "Commit the batch after successful processing. A stale or repeated receipt cannot skip a newer batch.",
    "fields": [
      {
        "name": "account",
        "type": "string",
        "required": true
      },
      {
        "name": "feed",
        "type": "string",
        "required": true
      },
      {
        "name": "receipt",
        "type": "string",
        "required": true
      },
      {
        "name": "folder",
        "type": "string",
        "default": "INBOX"
      }
    ]
  }
}
