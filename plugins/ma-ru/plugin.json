{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ma-ru",
  "version": "0.4.0",
  "description": "Почта Mail.ru для агентов. Поиск, метки, переписка и проверка новых писем по расписанию.",
  "author": {
    "name": "Антон Гребенников"
  },
  "repository": "https://github.com/grebennikovxyz/ma-ru-plugin",
  "license": "Apache-2.0",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Ma-Ru",
        "shortDescription": "Mail.ru для почтовых задач",
        "developerName": "Антон Гребенников",
        "category": "Productivity",
        "logo": "./assets/envelope.svg",
        "composerIcon": "./assets/envelope.svg",
        "defaultPrompt": [
          "Покажи новые письма в подключённом ящике",
          "Найди переписку по заказу и подготовь черновик ответа"
        ]
      }
    }
  }
}
